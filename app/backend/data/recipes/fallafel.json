  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Line a tray with parchment paper and preheat your oven to 180 Deg C"
    },
    {
      "@type": "HowToStep",
      "text": "Soaked Chickpeas, double in size. So if you want 2 Cups of Soaked, use 1 cup of dry."
    },
    {
      "@type": "HowToStep",
      "text": "In a food processor put all the ingredients and grind it."
    },
    {
      "@type": "HowToStep",
      "text": "It will be like a coarse mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Take a gooseberry size or like 2 tablespoon of the mix and make small balls from it, by gently pressing it between your palms."
    },
    {
      "@type": "HowToStep",
      "text": "Line it evenly on a baking tray.&nbsp;Lightly brush them with oil."
    },
    {
      "@type": "HowToStep",
      "text": "Let them bake for 20-30 minutes turning in between. (Half baked Pic)"
    },
    {
      "@type": "HowToStep",
      "text": "Bake them until they are golden brown on all the sides."
    },
    {
      "@type": "HowToStep",
      "text": "Serve it with Tahini dip, Hummus,  Baba Ghanoush or as a sandwich in Pita bread or a wrap."
    }
  ],
