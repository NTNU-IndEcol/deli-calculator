  "name": "Dubu salad (Korean Tofu Salad)",
  "author": "Hyosun",
  "datePublished": "2023-03-05T09:42:00+00:00",
  "category": [
    "Salad",
    "Side Dish"
  ],
  "recipeIngredient": [
    {
      "mainIngredient": "Soft or silken tofu",
      "details": {
        "amount": 1.0,
        "unit": "package",
        "originalText": "1 package soft or silken tofu"
      }
    },
    {
      "mainIngredient": "Spring salad mix",
      "details": {
        "amount": 2.0,
        "unit": "ounces",
        "originalText": "2  ounces spring salad mix"
      }
    },
    {
      "mainIngredient": "Scallions , finely chopped, 1/4 cup",
      "details": {
        "amount": 2.0,
        "unit": null,
        "originalText": "2  scallions (1 if large), finely chopped, about 1/4 cup"
      }
    },
    {
      "mainIngredient": "Minced garlic",
      "details": {
        "amount": 0.5,
        "unit": "teaspoon",
        "originalText": "1/2 teaspoon minced garlic"
      }
    },
    {
      "mainIngredient": "Soy sauce",
      "details": {
        "amount": 2.0,
        "unit": "tablespoons",
        "originalText": "2 tablespoons soy sauce"
      }
    },
    {
      "mainIngredient": "Vinegar or lemon juice",
      "details": {
        "amount": 1.0,
        "unit": "tablespoon",
        "originalText": "1 tablespoon vinegar or lemon juice"
      }
    },
    {
      "mainIngredient": "Rice wine , or matsul )",
      "details": {
        "amount": 1.0,
        "unit": "tablespoon",
        "originalText": "1 tablespoon rice wine (mirin, mirim (미림), or matsul (맛술))"
      }
    },
    {
      "mainIngredient": "Sugar",
      "details": {
        "amount": 1.0,
        "unit": "teaspoon",
        "originalText": "1 teaspoon sugar (or 2 teaspoons Korean plum syrup -maesilcheong, 매실청)"
      }
    },
    {
      "mainIngredient": "Gochugaru",
      "details": {
        "amount": 0.5,
        "unit": "teaspoon",
        "originalText": "1/2 teaspoon gochugaru (Korean red chili pepper flakes) (Adjust to taste)"
      }
    },
    {
      "mainIngredient": "Sesame oil",
      "details": {
        "amount": 1.0,
        "unit": "teaspoon",
        "originalText": "1 teaspoon sesame oil"
      }
    },
    {
      "mainIngredient": "Sesame seeds",
      "details": {
        "amount": 2.0,
        "unit": "teaspoons",
        "originalText": "2 teaspoons sesame seeds"
      }
    }
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the sauce ingredients in a small bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Wash the spring mix and drain."
    },
    {
      "@type": "HowToStep",
      "text": "In a medium size pot, bring about 4 cups of water to a boil and add the tofu. Cover and boil for 5 minutes over medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Carefully transfer the tofu to a colander to drain and cool."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tofu into two blocks. Cut each block into about 1/2-inch thick slices."
    },
    {
      "@type": "HowToStep",
      "text": "Spread some spring mix on a plate. Arrange the tofu slices on top of the spring mix. Drizzle the sauce over the tofu when ready to serve."
    }
  ],
  "recipeYield": [
    "2"
  ],
  "prepTime": "PT10M",
  "cookTime": "PT10M",
