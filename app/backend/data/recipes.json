  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 375 F."
    },
    {
      "@type": "HowToStep",
      "text": "Spray a loaf plan with nonstick spray and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "In a large mixing bowl, combine ground beef, onion, eggs, garlic, ketchup, Worchestershire sauce, parsley, breadcrumbs, milk, Italian seasoning, smoked paprika, salt and black pepper. Mix until well combined."
    },
    {
      "@type": "HowToStep",
      "text": "Place meatloaf mixture into prepared loaf pan. Bake at 375 F for 40 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Start preparing the meatloaf sauce. In a small mixing bowl, mix ketchup, white vinegar, brown sugar, garlic powder, onion powder, salt, and black pepper. Whisk until ingredients are well combined. Spread the meatloaf glaze on top when it has 15 minutes left to bake."
    },
    {
      "@type": "HowToStep",
      "text": "Let the meatloaf rest for 5 minutes. Top with fresh parsley and enjoy!"
    }
  ],
